{
  "name": "dsh-unified-context",
  "version": "0.5.0",
  "packageManager": "pnpm@11.7.0",
  "description": "DSH Unified Context (统一上下文): migrate pi/opencode/codex/claude-code/WorkBuddy sessions into DeepSeek Harness, share AGENTS.md/skills/project & agent memory through symlinks, and migrate automations. One context, every harness.",
  "type": "module",
  "main": "plugin/index.mjs",
  "exports": {
    ".": "./plugin/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/",
    "plugin/",
    "src/",
    "scripts/",
    "assets/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "cordis.patch.yml",
    "import.mjs",
    "export.mjs",
    "README.zh.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "import": "node import.mjs",
    "export": "node export.mjs",
    "e2e": "node scripts/e2e-commands.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0",
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-user-questions": ">=0.1.0-rc.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vitest": "^4.1.10"
  },
  "homepage": "https://github.com/Chang-Tong/dsh-unified-context",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chang-Tong/dsh-unified-context.git"
  },
  "bugs": {
    "url": "https://github.com/Chang-Tong/dsh-unified-context/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "migration",
    "context",
    "agents-md",
    "skills",
    "workbuddy",
    "codex",
    "claude-code",
    "opencode",
    "pi"
  ]
}
